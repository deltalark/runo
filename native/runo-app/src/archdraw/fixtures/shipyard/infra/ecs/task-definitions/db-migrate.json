{
  "family": "shipyard-db-migrate",
  "requiresCompatibilities": ["FARGATE"],
  "networkMode": "awsvpc",
  "cpu": "256",
  "memory": "512",
  "containerDefinitions": [
    {
      "name": "db-migrate",
      "image": "123456789012.dkr.ecr.eu-west-1.amazonaws.com/shipyard-api:latest",
      "command": ["npm", "run", "migrate"],
      "essential": true,
      "environment": [{ "name": "DATABASE_HOST", "value": "shipyard-prod.abc123.eu-west-1.rds.amazonaws.com" }]
    }
  ]
}
